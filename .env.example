# Development only: leave unset to use .local/still.db (never used on Vercel).
# LOCAL_DATABASE_PATH=.local/still.db
# Production: provision Turso through Vercel Marketplace; pull with vercel env pull.
# Both values are server-only. Never use NEXT_PUBLIC_ for database credentials.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Optional local reviewer fixture only:
# DEMO_PASSWORD=
