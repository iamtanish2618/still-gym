# No application secret is required for normal login: opaque tokens are random,
# and only their hashes are stored in D1. Never commit .env or .dev.vars.
# Local-only seed override. The README demo uses the documented public password.
DEMO_PASSWORD=StillDemo2026!
# Hosted, one-time demo seeding only. Set a random 32-byte value in the hosting
# secret store, call POST /api/setup with X-Setup-Key, then remove this variable.
# SETUP_KEY=
