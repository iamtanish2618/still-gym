{
  "name": "still-gym",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 5173",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 5173",
    "test": "node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "admin:create": "node --env-file-if-exists=.env.local scripts/create-admin.mjs",
    "db:seed:demo": "node --env-file-if-exists=.env.local scripts/seed-local.mjs",
    "test:browser": "node test/browser.mjs && node test/browser-states.mjs",
    "test:browser:audit": "node test/browser-booking-audit.mjs",
    "test:browser:real": "node test/browser-real-backend.mjs",
    "test:live": "node test/live-booking.mjs",
    "format": "prettier --write app server test db scripts"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "@libsql/client": "0.18.0",
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "playwright": "^1.62.1",
    "prettier": "^3.6.2",
    "typescript": "5.9.3"
  },
  "type": "module"
}
