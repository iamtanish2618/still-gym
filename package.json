{
  "name": "still-gym",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 5173",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 5173",
    "test": "node --test tests/unit/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "admin:create": "node --env-file-if-exists=.env.local scripts/create-admin.mjs",
    "db:seed:demo": "node --env-file-if-exists=.env.local scripts/seed-local.mjs",
    "test:browser": "node tests/browser/browser.mjs && node tests/browser/browser-states.mjs",
    "test:browser:audit": "node tests/browser/browser-booking-audit.mjs",
    "test:browser:real": "node tests/browser/browser-real-backend.mjs",
    "test:live": "node tests/browser/live-booking.mjs",
    "format": "prettier --write app server tests db scripts",
    "test:browser:admin": "node tests/browser/browser-admin-switch.mjs",
    "test:browser:schedule": "node tests/browser/browser-schedule-persistence.mjs",
    "test:browser:persistence": "node tests/browser/browser-persistence.mjs",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"server/**/*.mjs\" --test-coverage-lines=95 --test-coverage-branches=85 --test-coverage-functions=95 tests/unit/*.test.mjs",
    "test:e2e": "node tests/run-browser.mjs",
    "test:all": "npm run typecheck && npm run lint && npm run test:coverage && npm run build && npm run test:e2e",
    "format:check": "prettier --check app server tests db scripts",
    "lint": "eslint app server scripts tests db eslint.config.mjs next.config.ts"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "drizzle-orm": "0.45.2",
    "next": "16.4.2",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "playwright": "1.62.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  },
  "type": "module"
}
